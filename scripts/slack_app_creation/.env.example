# App configuration token (xoxe...). Generate one at
# https://api.slack.com/apps -> your app -> App Configuration Tokens.
SLACK_CONFIG_TOKEN=

# Optional: config tokens expire after 12 hours; set this to rotate it first.
SLACK_CONFIG_REFRESH_TOKEN=

# Local callback port (default 8099).
SLACK_INSTALL_PORT=8099

# App config is read from manifest.yml (next to this file) unless another
# manifest file is passed as the first argument.
