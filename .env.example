SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_USER_TOKEN=
# Comma-separated list of user tokens (each from a separate Slack account) to
# scale scraping. Falls back to SLACK_USER_TOKEN if unset.
SLACK_USER_TOKENS=
# Avg ms between requests per Slack API method per token (default 1200).
# Slack rate limits are per-method: tier 3 = 50 req/min/method (~1200ms),
# tier 4 = 100 req/min/method (~600ms), tier 2 = 20 req/min/method (~3000ms).
SLACK_REQUEST_DELAY_MS=1200
# Max in-flight (burst) requests per method per token (default 8).
SLACK_MAX_INFLIGHT=8
# How many channels are scraped concurrently per token (default 64).
# The per-method rate limiter still caps actual request rate, so this just
# keeps quick channels flowing even while large channels are being scraped.
SLACK_CHANNEL_CONCURRENCY=64
HOST=0.0.0.0
PORT=3000
# Public base URL of this app, used for OAuth redirect_uri values.
BASE_URL=http://localhost:3000
# HMAC secret for signing session cookies. Use a long random string.
SESSION_SECRET=
# Hack Club Auth (HCA) OAuth app credentials. Required for sign-in.
# HCA app: https://auth.hackclub.com
# Redirect URI: http://localhost:3000/auth/hackclub/callback (something like this)
# Scopes: slack_id, name
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=
# Hackatime OAuth app credentials. Required for coding activity sync.
# Hackatime app: https://hackatime.hackclub.com/oauth/applications
# Redirect URI: http://localhost:3000/auth/hackatime/callback (somethine like this)
# Scopes: profile, read
HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=
