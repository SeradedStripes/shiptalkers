# Required
# Production database connection string shared with the app.
DATABASE_URL=postgres://ship_talkers:ship_talkers@localhost:5432/ship_talkers
# Bot tokens, comma-separated. One token is sufficient for Slack scraping.
# Numbered variants such as SLACK_BOT_TOKENS_1 also work.
SLACK_BOT_TOKENS=

# Unrequired
# OAuth user tokens are loaded from the shared database.
# Request delay per method and token in milliseconds.
SLACK_REQUEST_DELAY_MS=1200
# Maximum in-flight requests per method and token.
SLACK_MAX_INFLIGHT=8
# Channels scraped concurrently per OAuth token.
SLACK_CHANNEL_CONCURRENCY=8
# Maximum incremental sweep duration in seconds.
SLACK_INCREMENTAL_BUDGET_SECS=300
# Delay between Slack user sync requests in milliseconds.
SLACK_USER_SYNC_DELAY_MS=3000
# Thread rescan history window in hours.
SLACK_THREAD_RESCAN_HOURS=168
# Thread rescan interval in hours.
SLACK_THREAD_RESCAN_INTERVAL_HOURS=24
# Hackatime coding-time sync runs on its own 30m cycle here (no env knobs): it
# pulls spans for every user into the shared database, so it keeps running
# while the app container restarts. Tokens granted via the app's link page are
# picked up automatically on the next pass.
# Maximum Postgres connections for the app and scraper combined.
DATABASE_MAX_CONNECTIONS=3
# Health endpoint port.
HEALTH_PORT=3001
