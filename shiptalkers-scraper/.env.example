# Slack tokens (one per Slack app), comma-separated. Bot tokens power the
# channel list and user sync; user tokens pull message history from the shared
# channel work queue. Numbered variants (SLACK_BOT_TOKENS_1, ...) also work.
# Both are optional: the hackatime coding-time sync below runs without them.
SLACK_BOT_TOKENS=
SLACK_USER_TOKENS=
# Request pacing per method per token (default 1200, tier 3 50 req/min) and
# burst per method per token (default 8).
SLACK_REQUEST_DELAY_MS=1200
SLACK_MAX_INFLIGHT=8
# Channels scraped concurrently per user token (default 8) and interval between
# user sync passes (default 3000).
SLACK_CHANNEL_CONCURRENCY=8
SLACK_USER_SYNC_DELAY_MS=3000
# Thread rescan history window (default 720 hours = 30 days) and how often
# fully-scraped channels are re-scanned for threads (default 6 hours).
SLACK_THREAD_RESCAN_HOURS=720
SLACK_THREAD_RESCAN_INTERVAL_HOURS=6
# Hackatime coding-time sync runs on its own 30m cycle here (no env knobs): it
# pulls spans for every user into the shared database, so it keeps running
# while the app container restarts. Tokens granted via the app's link page are
# picked up automatically on the next pass.
# Postgres connection string. Shares the same database as the main app so what
# the scraper writes is immediately readable by the website.
DATABASE_URL=postgres://ship_talkers:ship_talkers@localhost:5432/ship_talkers