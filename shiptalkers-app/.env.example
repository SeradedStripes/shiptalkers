# Bot tokens (one per Slack app), comma-separated. The first entry is the main
# bot and is used for all stats bot replies. Optional; disables the bot when
# unset. Scraping uses its own SLACK_BOT_TOKENS/SLACK_USER_TOKENS in the
# separate scraper container (see shiptalkers-scraper/.env.example).
SLACK_BOT_TOKENS=
# App tokens (one per Slack app), comma-separated. Each opens its own Socket
# Mode connection; message events are sharded so only one bot replies.
# Optional, disables the stats bot.
SLACK_APP_TOKENS=
# Channel ID the stats bot watches. When a user posts a time range there, the
# bot replies in a thread with their stats (if linked) or a link prompt.
SLACK_MAIN_CHANNEL=
# Postgres connection string. All app data (messages, reactions, users,
# channels, hackatime spans, scores, auth) lives in this one database.
DATABASE_URL=postgres://ship_talkers:ship_talkers@localhost:5432/ship_talkers
HOST=0.0.0.0
PORT=3000
# Public base URL of this app, used for OAuth redirect_uri values.
BASE_URL=http://localhost:3000
# HMAC secret for signing session cookies. Use a long random string.
SESSION_SECRET=
# Hack Club Auth (HCA) OAuth app credentials. Required for sign-in.
# HCA app: https://auth.hackclub.com
# Redirect URI: http://localhost:3000/auth/hackclub/callback (something like this)
# Scopes: slack_id, name
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=
# Hackatime OAuth app credentials. Required for the link page, where a user
# with a private coding profile grants this app read access. The scraper
# container then syncs coding time with the saved token.
# Hackatime app: https://hackatime.hackclub.com/oauth/applications
# Redirect URI: http://localhost:3000/auth/hackatime/callback (something like this)
# Scopes: profile, read
HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=
