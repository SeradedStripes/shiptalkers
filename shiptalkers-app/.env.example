# Bot tokens (one per Slack app), comma-separated. conversations.list and
# users.list pages round-robin across them; each token gets its own rate-limit
# budget. The first entry is the main bot and is used for all stats bot
# replies. Required.
SLACK_BOT_TOKENS=
# User tokens (one per Slack app), comma-separated, to scale message scraping.
# Channels are pulled from a shared work queue, so tokens that finish slow
# channels immediately grab the next one instead of idling on a fixed shard.
# Every channel is checked for new messages once per 30-minute scrape cycle, so
# the full pass must fit in 30m for the cadence to hold. An incremental pass
# costs roughly one API call per channel: with N user tokens at ~50 req/min
# each, the pass takes ~channels / (N * 50) minutes. Add more user tokens or
# lower SLACK_REQUEST_DELAY_MS to keep a 30m full pass.
SLACK_USER_TOKENS=
# App tokens (one per Slack app), comma-separated. Each opens its own Socket
# Mode connection; message events are sharded so only one bot replies.
# Optional, disables the stats bot.
SLACK_APP_TOKENS=
# Channel ID the stats bot watches. When a user posts a time range there, the
# bot replies in a thread with their stats (if linked) or a link prompt.
SLACK_MAIN_CHANNEL=
# Postgres connection string. All app data (messages, reactions, users,
# channels, hackatime spans, scores, auth) lives in this one database.
DATABASE_URL=postgres://ship_talkers:ship_talkers@localhost:5432/ship_talkers
# Avg ms between requests per Slack API method per token (default 1200).
# Slack rate limits are per-method: tier 3 = 50 req/min/method (~1200ms),
# tier 4 = 100 req/min/method (~600ms), tier 2 = 20 req/min/method (~3000ms).
SLACK_REQUEST_DELAY_MS=1200
# Max in-flight (burst) requests per method per token (default 8).
SLACK_MAX_INFLIGHT=8
# Pacing for the users.list sync pool (one limiter per bot token, tier 2,
# 20 req/min, default 3000).
# The initial sync is a full scrape; later syncs only write users whose `updated`
# timestamp changed.
SLACK_USER_SYNC_DELAY_MS=3000
# How many channels are scraped concurrently per token (default 8).
# The per-method rate limiter still caps actual request rate, so this just
# keeps quick channels flowing even while large channels are being scraped.
SLACK_CHANNEL_CONCURRENCY=8
# Thread rescan: every SLACK_THREAD_RESCAN_INTERVAL_HOURS hours, fully-scraped
# channels refetch the last SLACK_THREAD_RESCAN_HOURS hours of history so
# messages that gained a thread after first scrape get their replies fetched.
# Defaults: 168h window, every 6h.
SLACK_THREAD_RESCAN_HOURS=168
SLACK_THREAD_RESCAN_INTERVAL_HOURS=6
HOST=0.0.0.0
PORT=3000
# Public base URL of this app, used for OAuth redirect_uri values.
BASE_URL=http://localhost:3000
# HMAC secret for signing session cookies. Use a long random string.
SESSION_SECRET=
# Hack Club Auth (HCA) OAuth app credentials. Required for sign-in.
# HCA app: https://auth.hackclub.com
# Redirect URI: http://localhost:3000/auth/hackclub/callback (something like this)
# Scopes: slack_id, name
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=
# Hackatime OAuth app credentials. Required for coding activity sync.
# Hackatime app: https://hackatime.hackclub.com/oauth/applications
# Redirect URI: http://localhost:3000/auth/hackatime/callback (somethine like this)
# Scopes: profile, read
HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=
