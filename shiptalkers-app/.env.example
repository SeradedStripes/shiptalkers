# Required
# Production database connection string.
DATABASE_URL=postgres://ship_talkers:ship_talkers@localhost:5432/ship_talkers
# Production session cookie signing secret.
SESSION_SECRET=
# Hack Club Auth OAuth credentials.
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=
# Hackatime OAuth credentials.
HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=
# Public URL used for OAuth redirects.
BASE_URL=https://example.com
# Slack OAuth credentials.
# Required user scopes: channels:read, channels:history, groups:read, groups:history.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Bot tokens, comma-separated. One token is sufficient.
# Scraping uses OAuth user installations from the shared database.
SLACK_BOT_TOKENS=
# App tokens, comma-separated. Enables the stats bot's Socket Mode.
SLACK_APP_TOKENS=
# Channel ID watched by the stats bot.
SLACK_MAIN_CHANNEL=

# Unrequired
# Server bind address.
HOST=0.0.0.0
# Server port.
PORT=3000
